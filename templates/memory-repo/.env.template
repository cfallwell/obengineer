# Memory repository environment.
# Copy this file to .env and fill the values there.
# .env is gitignored. This file is committed.
# Leave a value empty until you have it.
# Never put a real key, token, customer name, or other personal data in this file.

# Splunk Observability Cloud realm, for example us0.
# The API base is https://api.<realm>.signalfx.com.
# There is no second base-URL variable.
# The org id stays tenancy.o11y_org_id in engagement-inputs.yaml.
SPLUNK_REALM=

# Admin-level API key for the Splunk Observability Cloud API.
# The splunk-observability MCP reads it, and the existing-telemetry pass reads it.
# Splunk_O11y_API_Key is the same secret. This is the only variable.
SPLUNK_ACCESS_TOKEN=

# Splunk Enterprise base URL, for example https://<host>:8089.
# Same fact as tenancy.splunk_platform_host. The value lives here.
SPLUNK_HOST=

# Splunk Enterprise API token for search and introspection.
# The splunk-platform MCP reads it, and the existing-telemetry pass reads it.
# SPLUNK_ENTERPRISE_TOKEN is the same secret. This is the only variable.
SPLUNK_TOKEN=

# Comma-separated Splunk Enterprise indexes the analyze run may search.
# Example of shape: main,app_logs
SPLUNK_ENTERPRISE_INDEXES=

# Cisco ThousandEyes bearer token.
# Set it only when the thousandeyes MCP server is enabled.
TE_OAUTH_BEARER_TOKEN=
