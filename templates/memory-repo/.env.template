PRODUCTION_URL=
TEST_LOGIN_ID=
PASSWORD_REF=
# These first three values describe the production surface and optional dummy login.
# PASSWORD_REF must be a ${VAR} reference. Never put a raw password here.

# Required start answers. Use NO_BROWSER_REASON only when no production browser
# applies; do not set it together with PRODUCTION_URL.
APPLICATION=
NO_BROWSER_REASON=
WHAT_HURTS=

# Suggested input 1: supplied artifacts. This directory is created by project install.
ARTIFACTS_DIR=artifacts
ARTIFACT_DIAGRAMS=
ARTIFACT_NARRATIVE=
PRIOR_CONTRACT=
PRIOR_SCHEMA=
PRIOR_SCANS=
HOUSE_STYLE_DOCX=

# Suggested input 2: passive, safe-active, or none. Origins and paths are comma-separated.
SECURITY_ASSESSMENT_MODE=
SECURITY_AUTHORIZED_ORIGINS=
SECURITY_EXCLUDED_PATHS=

# Suggested input 4: tenant realm and deployment.environment values.
SPLUNK_REALM=
DEPLOYMENT_ENVIRONMENTS=

# Suggested input 5: order-form entitlement and optional traffic baselines.
CUSTOM_MTS_ENTITLED=
MMS_CARDINALITY_ENTITLED=
RUM_SESSIONS_PER_DAY_AVG=
APM_REQUESTS_PER_MINUTE_AVG=
LOG_GB_PER_HOUR_AVG=

# Suggested input 6: privacy, residency, consent, and change constraints.
PRIVACY_REGIMES=
DATA_RESIDENCY=
CONSENT_PLATFORM=
CHANGE_WINDOWS=

# Suggested input 7: incident and business context.
MTTD_MINUTES=
MTTA_MINUTES=
MTTR_MINUTES=
INCIDENTS_PER_MONTH=
ENGINEERING_HOURS_PER_MONTH_ON_TRIAGE=
REVENUE_PER_HOUR_ONLINE=

# Suggested input 8: bounded public-record research.
PUBLIC_RESEARCH_ALLOWED=
PUBLIC_BRAND_TERMS=

# Suggested inputs 9 and 10.
ANALYSIS_PERCENTILE=
FIRST_JOURNEY=

# Optional non-secret Splunk connection inputs.
# Run scripts/setup-splunk-access.sh to put token values only in ignored local .env.
# The prefill script records ${SPLUNK_ACCESS_TOKEN} and ${SPLUNK_TOKEN}, never values.
SPLUNK_HOST=
SPLUNK_ENTERPRISE_INDEXES=
