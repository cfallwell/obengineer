{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obengineer.dev/schemas/run-context.schema.json",
  "title": "obengineer deterministic intake run context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "turn",
    "state",
    "analysis_authorized",
    "required",
    "optional",
    "last_event"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "turn": {"type": "integer", "minimum": 0},
    "state": {
      "enum": ["new", "required", "optional-review", "optional-answers"]
    },
    "analysis_authorized": {"type": "boolean"},
    "required": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application", "production-surface", "what-hurts"],
      "properties": {
        "application": {"enum": ["pending", "complete", "skipped"]},
        "production-surface": {"enum": ["pending", "complete", "skipped"]},
        "what-hurts": {"enum": ["pending", "complete", "skipped"]}
      }
    },
    "optional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "offered", "selected", "pending"],
      "properties": {
        "items": {
          "type": "object",
          "patternProperties": {
            "^(?:[1-9]|10)$": {"enum": ["pending", "complete", "skipped"]}
          },
          "additionalProperties": false
        },
        "offered": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 10},
          "uniqueItems": true
        },
        "selected": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 10},
          "uniqueItems": true
        },
        "pending": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1, "maximum": 10},
          "uniqueItems": true
        }
      }
    },
    "last_event": {
      "enum": ["initialize", "start", "required", "review-yes", "answer", "review-no"]
    }
  }
}
