{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obengineer.dev/schemas/analysis-run-timing.schema.json",
  "title": "Analysis run timing audit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analysisId", "startedAt", "completedAt", "phases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "analysisId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+-V[1-9][0-9]*$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection", "reconciliation", "render", "validation"],
      "properties": {
        "collection": { "$ref": "#/$defs/interval" },
        "reconciliation": { "$ref": "#/$defs/interval" },
        "render": { "$ref": "#/$defs/interval" },
        "validation": { "$ref": "#/$defs/interval" }
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startedAt", "completedAt"],
      "properties": {
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
