{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "OBSERVABILITY_ENGINEER_HOST=codex python3 \"${PLUGIN_ROOT}/hooks/bootstrap_obengineer.py\"",
            "commandWindows": "set \"OBSERVABILITY_ENGINEER_HOST=codex\" && py -3 \"${PLUGIN_ROOT}/hooks/bootstrap_obengineer.py\"",
            "statusMessage": "Checking obengineer prerequisites"
          }
        ]
      }
    ]
  }
}
