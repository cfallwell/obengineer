{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obengineer.dev/schemas/analysis-job-manifest.schema.json",
  "title": "Analysis job manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisId",
    "executionAuthority",
    "repositoryCapability",
    "hostConcurrency",
    "performanceBudgets",
    "jobs"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "analysisId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+-V[1-9][0-9]*$" },
    "executionAuthority": { "const": "host" },
    "repositoryCapability": { "const": "audit-only" },
    "hostConcurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConcurrentAgents", "coordinatorSlots"],
      "properties": {
        "maxConcurrentAgents": { "type": "integer", "minimum": 2 },
        "coordinatorSlots": { "const": 1 }
      }
    },
    "performanceBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalSeconds",
        "collectionSeconds",
        "reconciliationSeconds",
        "renderSeconds",
        "validationSeconds",
        "progressIntervalSeconds"
      ],
      "properties": {
        "totalSeconds": { "type": "integer", "minimum": 1, "maximum": 1200 },
        "collectionSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
        "reconciliationSeconds": { "type": "integer", "minimum": 1, "maximum": 240 },
        "renderSeconds": { "type": "integer", "minimum": 1, "maximum": 180 },
        "validationSeconds": { "type": "integer", "minimum": 1, "maximum": 120 },
        "progressIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    },
    "jobs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "runnable", "deadlineSeconds", "evidenceScopes", "requiredOutputs"],
        "properties": {
          "id": {
            "enum": [
              "production",
              "source-technology",
              "diagrams-prior-artifacts",
              "observability-cloud",
              "platform-cloud-messaging",
              "public-security"
            ]
          },
          "title": { "type": "string", "minLength": 8 },
          "runnable": { "type": "boolean" },
          "deadlineSeconds": { "type": "integer", "minimum": 1, "maximum": 600 },
          "evidenceScopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3 }
          },
          "requiredOutputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3 }
          },
          "skipReason": { "type": "string", "minLength": 12 }
        },
        "allOf": [
          {
            "if": { "properties": { "runnable": { "const": false } } },
            "then": { "required": ["skipReason"] }
          }
        ]
      }
    }
  }
}
