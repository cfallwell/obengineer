{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obengineer.dev/schemas/analysis-worker-result.schema.json",
  "title": "Analysis worker result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "analysisId",
    "jobId",
    "status",
    "startedAt",
    "completedAt",
    "evidence",
    "facts",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "analysisId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+-V[1-9][0-9]*$" },
    "jobId": {
      "enum": [
        "production",
        "source-technology",
        "diagrams-prior-artifacts",
        "observability-cloud",
        "platform-cloud-messaging",
        "public-security"
      ]
    },
    "status": { "enum": ["completed", "limited", "skipped", "failed"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "facts": {
      "type": "array",
      "items": { "$ref": "#/$defs/fact" }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 12 }
    },
    "error": { "type": "string", "minLength": 12 }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "source", "observedAt", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^EV-[A-Z0-9-]+$" },
        "kind": {
          "enum": ["measured", "stated", "public", "derived"]
        },
        "source": { "type": "string", "minLength": 3 },
        "observedAt": { "type": "string", "format": "date-time" },
        "summary": { "type": "string", "minLength": 20 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidenceIds", "statement", "confidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^FACT-[A-Z0-9-]+$" },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^EV-[A-Z0-9-]+$" }
        },
        "statement": { "type": "string", "minLength": 20 },
        "confidence": { "enum": ["confirmed", "high", "medium", "low"] }
      }
    }
  }
}
